# Copy this file to ".env" (in the same frontend/ directory) before running `npm start`.
#
# Base URL of the Flask backend. The React app reads this at build/start time
# via process.env.REACT_APP_API_URL. Create React App only exposes environment
# variables that begin with the REACT_APP_ prefix to the browser bundle.
#
# If this variable is not set, the app falls back to http://localhost:5000
# (see src/api.js).
REACT_APP_API_URL=http://localhost:5000
