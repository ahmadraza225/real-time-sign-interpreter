# =============================================================================
# .gitignore - Real-Time Sign Language Interpreter
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ---- Generated data & model artifacts ----
# Keep the folders (via .gitkeep) but ignore their large generated contents.
data/processed/*
!data/processed/.gitkeep
data/raw/*
!data/raw/.gitkeep
models/*.pt
models/*.json
*.npz

# Raw datasets are huge and provided separately; never commit them.
datasets/

# ---- Node / React frontend ----
node_modules/
frontend/node_modules/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Logs & misc training output ----
*.log
runs/
logs/
*.png
!docs/**/*.png

# ---- IDE / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
